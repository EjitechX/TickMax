rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validAccount(data) {
      return data.name is string
        && data.name.size() > 0
        && data.initialBalance is number
        && data.initialBalance > 0
        && data.balance is number
        && data.equity is number
        && data.currency == 'USD'
        && data.mode == 'simulation'
        && data.algoEnabled is bool;
    }

    match /users/{uid} {
      allow create: if isOwner(uid);
      allow read, update: if isOwner(uid);
      allow delete: if false;

      match /accounts/{accountId} {
        allow create: if isOwner(uid) && validAccount(request.resource.data);
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && validAccount(request.resource.data);
        allow delete: if isOwner(uid);

        match /trades/{tradeId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.status == 'OPEN'
            && request.resource.data.side in ['BUY', 'SELL']
            && request.resource.data.quantity > 0
            && request.resource.data.price > 0
            && request.resource.data.notional == request.resource.data.quantity * request.resource.data.price;
          allow update: if isOwner(uid);
          allow delete: if isOwner(uid);
        }
      }
    }
  }
}
